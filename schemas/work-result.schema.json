{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pstack:schema:work-result:v1",
  "title": "Portable Work Result",
  "type": "object",
  "required": ["version", "status", "summary", "evidence", "risks", "next_steps"],
  "properties": {
    "version": { "const": "1" },
    "status": { "enum": ["complete", "incomplete", "blocked"] },
    "summary": { "type": "string", "minLength": 1 },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["claim", "reference"],
        "properties": {
          "claim": { "type": "string", "minLength": 1 },
          "reference": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "decisions": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "risks": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "next_steps": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    }
  },
  "additionalProperties": false
}
