{
  "version": "2",
  "purpose": "Keep the portable core declarative and independent of any host.",
  "allowed_file_types": [".json", ".md"],
  "file_exceptions": ["LICENSE", "NOTICE", "UPSTREAM.md"],
  "required_paths": [
    "README.md",
    "LICENSE",
    "NOTICE",
    "UPSTREAM.md",
    "principles/README.md",
    "playbooks/selection.md",
    "protocols/context.md",
    "protocols/model-routing.md",
    "protocols/pstack-mode.md",
    "protocols/review.md",
    "routing/default-policy.json",
    "schemas/capability-catalog.schema.json",
    "schemas/context-bundle.schema.json",
    "schemas/mode-state.schema.json",
    "schemas/routing-decision.schema.json",
    "schemas/routing-overrides.schema.json",
    "schemas/routing-policy.schema.json",
    "schemas/work-result.schema.json"
  ],
  "forbidden_capabilities": [
    "host-branding",
    "host-task-api",
    "implicit-session-state",
    "provider-specific-routing",
    "package-bootstrap",
    "credential-access",
    "network-access",
    "external-write",
    "automation-pack"
  ],
  "provenance_exceptions": ["NOTICE", "UPSTREAM.md"]
}
